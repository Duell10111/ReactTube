{
  "compilerOptions": {
    // Pure modules covered by the Node test runner import their neighbours with
    // an explicit extension, because node cannot resolve an extensionless one.
    "allowImportingTsExtensions": true,
    // baseUrl is deprecated as of TypeScript 6; paths resolve relative to this file.
    "paths": {
      "@/*": ["./src/*"]
    },
    // TypeScript 6 enables "strict" by default. The project has only ever opted
    // into strictNullChecks, so keep the previous strictness level explicitly.
    "strict": false,
    "strictNullChecks": true // Needed for drizzle atm: https://github.com/drizzle-team/drizzle-orm/issues/2889#issuecomment-2407712651
  },
  "extends": "expo/tsconfig.base",
  // Repeats the base excludes because "exclude" replaces them. Node tooling
  // under scripts/ and test/ pulls in @types/node, whose globals do not apply
  // to the React Native app.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "scripts",
    "test"
  ]
}
